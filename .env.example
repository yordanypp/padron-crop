# Copy to .env and fill in locally. NEVER commit the real values.
# padron-crop reads these from the environment only (no secrets in code/config).

# SQLAlchemy DSN for the `sql` ingestion (MySQL/MariaDB/PostgreSQL/SQLite).
# Examples:
#   mysql+pymysql://user:password@host:3306/dbname
#   postgresql+psycopg://user:password@host:5432/dbname
#   sqlite:///local.db
PADRON_DB_URL=

# Bearer token for the `api` ingestion.
PADRON_API_TOKEN=
